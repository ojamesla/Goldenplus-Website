<?xml version="1.0" ?>
<configuration>
    <system.webServer>
        <!-- Revalidate static files; HTML also uses content-versioned CSS/JS URLs. -->
        <staticContent>
            <clientCache cacheControlMode="DisableCache"/>
        </staticContent>
        <rewrite>
            <rules>
                <!--News uses /news/ because the legacy news directory still exists.-->
                <rule name="News HTML canonical URL" stopProcessing="true">
                    <match url="^news\.html$" ignoreCase="false"/>
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                        <add input="{UNENCODED_URL}" pattern="^/news\.html(?:\?|$)"/>
                    </conditions>
                    <action type="Redirect" url="/news/" appendQueryString="true" redirectType="Permanent"/>
                </rule>
                <rule name="News directory canonical URL" stopProcessing="true">
                    <match url="^news$" ignoreCase="false"/>
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                    </conditions>
                    <action type="Redirect" url="/news/" appendQueryString="true" redirectType="Permanent"/>
                </rule>
                <rule name="Clean news directory" stopProcessing="true">
                    <match url="^news/$" ignoreCase="false"/>
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                    </conditions>
                    <action type="Rewrite" url="news.html" appendQueryString="true"/>
                </rule>
                <!-- Production-only canonical redirects and internal clean URL mappings. -->
                <rule name="Product canonical URL" stopProcessing="true">
                    <match url="^product\.html$" ignoreCase="false"/>
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                        <add input="{UNENCODED_URL}" pattern="^/product\.html\?"/>
                        <add input="{QUERY_STRING}" pattern="(?:^|&amp;)id=([A-Za-z0-9_-]+)(?:&amp;|$)"/>
                    </conditions>
                    <action type="Redirect" url="/products/{C:1}" appendQueryString="false" redirectType="Permanent"/>
                </rule>
                <rule name="Article canonical URL" stopProcessing="true">
                    <match url="^article\.html$" ignoreCase="false"/>
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                        <add input="{UNENCODED_URL}" pattern="^/article\.html\?"/>
                        <add input="{QUERY_STRING}" pattern="(?:^|&amp;)id=([A-Za-z0-9_-]+)(?:&amp;|$)"/>
                    </conditions>
                    <action type="Redirect" url="/news/{C:1}" appendQueryString="false" redirectType="Permanent"/>
                </rule>
                <rule name="Homepage canonical URL" stopProcessing="true">
                    <match url="^index\.html$" ignoreCase="false"/>
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                        <add input="{UNENCODED_URL}" pattern="^/index\.html(?:\?|$)"/>
                    </conditions>
                    <action type="Redirect" url="/" appendQueryString="true" redirectType="Permanent"/>
                </rule>
                <rule name="Page canonical URL" stopProcessing="true">
                    <match url="^(products|about|bde)\.html$" ignoreCase="false"/>
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                        <add input="{UNENCODED_URL}" pattern="^/(?:products|about|bde)\.html(?:\?|$)"/>
                    </conditions>
                    <action type="Redirect" url="/{R:1}" appendQueryString="true" redirectType="Permanent"/>
                </rule>
                <rule name="Remove trailing slash" stopProcessing="true">
                    <match url="^((?:products)(?:/[A-Za-z0-9_-]+)?|news/[A-Za-z0-9_-]+|about|bde)/$" ignoreCase="false"/>
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                    </conditions>
                    <action type="Redirect" url="/{R:1}" appendQueryString="true" redirectType="Permanent"/>
                </rule>
                <rule name="Clean listing pages" stopProcessing="true">
                    <match url="^(products|about|bde)$" ignoreCase="false"/>
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                    </conditions>
                    <action type="Rewrite" url="{R:1}.html" appendQueryString="true"/>
                </rule>
                <rule name="Clean product details" stopProcessing="true">
                    <match url="^products/[A-Za-z0-9_-]+$" ignoreCase="false"/>
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                    </conditions>
                    <action type="Rewrite" url="product.html" appendQueryString="true"/>
                </rule>
                <rule name="Clean news articles" stopProcessing="true">
                    <match url="^news/[A-Za-z0-9_-]+$" ignoreCase="false"/>
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^(?:www\.)?goldenplus-elec\.com\.tw(?::[0-9]+)?$" ignoreCase="true"/>
                    </conditions>
                    <action type="Rewrite" url="article.html" appendQueryString="true"/>
                </rule>
                <!-- Keep missing catalog files out of the legacy SiteBuilder PHP fallback. -->
                <rule name="StaticCatalog" stopProcessing="true">
                    <match url="^(?:(?:index|product|products|article|news|about|bde)\.html$|assets(?:/|$)|data(?:/|$))"/>
                    <action type="None"/>
                </rule>
                <rule name="SiteBuilder_Rule1" stopProcessing="true">
                    <match url="^((?:gallery|gallery_gen|img|css|js)\/.*|sitemap\.xml)$"/>
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true"/>
                    </conditions>
                    <action type="Rewrite" url="sitepro/{R:1}"/>
                </rule>
                <rule name="SiteBuilder_Rule2" stopProcessing="true">
                    <match url="(.*)"/>
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true"/>
                    </conditions>
                    <action type="Rewrite" url="sitepro/?route={R:1}"/>
                </rule>
            </rules>
        </rewrite>
        <defaultDocument enabled="true">
            <files>
                <clear/>
                <add value="index.html"/>
                <add value="index.php"/>
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>
