# Powered by Pumo.com.tw

<IfModule pagespeed_module>
	ModPagespeed off
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault A0
	# Revalidate pages and editable data on every visit.
	ExpiresByType text/html A0
	ExpiresByType application/json A0
	ExpiresByType image/gif A691200
	ExpiresByType image/png A691200
	ExpiresByType image/jpeg A691200
	ExpiresByType text/css A0
	ExpiresByType text/javascript A0
	ExpiresByType application/javascript A0
</IfModule>

# Keep validators (ETag / Last-Modified), but do not reuse stale site files.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js|json)$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

ErrorDocument 401 "Unauthorized"
ErrorDocument 403 "Forbidden"
<IfModule mod_negotiation.c>
	#Options -MultiViews
</IfModule>
RewriteEngine On
RewriteBase /
RewriteRule ^\.well-known/.+ - [L]

#### PERSISTENT CONTENT ####



#### PERSISTENT CONTENT END ####

# Prefer the new static homepage over a leftover SiteBuilder PHP entry point.
DirectoryIndex index.html index.php index.cgi
# Missing catalog files must return 404 instead of entering legacy PHP code.
RewriteRule ^(?:product(?:s)?\.html$|assets(?:/|$)|data(?:/|$)) - [L]
RewriteCond %{REQUEST_FILENAME} !-f [OR]
RewriteCond %{REQUEST_URI} ^\/(js\/(main\.js|boostrap\.min\.js)|css\/(\d+\.css|common\.css|site\.css|bootstrap\.min\.css))$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ sitepro/$1 [L,QSA]


